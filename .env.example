# DATABASE_URL은 .env 파일에 있음 (Prisma CLI 호환).

# ── NextAuth ──
AUTH_SECRET=replace_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth (선택) ──
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── AI (Claude 단일 모델) ──
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# 생성 전 웹 조사(web search) 사용. Console에서 web search 활성화 필요. 기본 off.
ANTHROPIC_WEB_SEARCH=false
ANTHROPIC_WEB_SEARCH_MAX_USES=3
# 검색 강제. true면 매 생성마다 최소 1회 web_search 수행(검색당 $10/1000 과금).
ANTHROPIC_WEB_SEARCH_FORCE=false

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
BACKEND_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_ANTHROPIC_WEB_SEARCH=true
